generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  student
  teacher

  @@map("user_type")
}

model User {
  id          Int              @id @default(autoincrement())
  firstName   String           @map("first_name")
  lastName    String           @map("last_name")
  userType    UserType         @map("user_type")
  student     Student?
  teacher     Teacher?
  departments UserDepartment[]

  @@index([firstName])
  @@index([lastName])
  @@map("user")
}

model Department {
  id       Int              @id @default(autoincrement())
  name  String           @unique
  users UserDepartment[]

  @@map("department")
}

model Student {
  id               Int    @id @default(autoincrement())
  enrollmentNumber String @unique @map("enrollment_number")
  userId           Int    @unique @map("user_id")
  // Cascade: deleting the user removes its student profile
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student")
}

model Teacher {
  id          Int    @id @default(autoincrement())
  designation String
  expertise   String
  userId      Int    @unique @map("user_id")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher")
}

// The only link between users and departments: a student or teacher can belong to several
model UserDepartment {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId Int        @map("department_id")
  // Restrict: a department can't be deleted while users still belong to it
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("user_department")
}
